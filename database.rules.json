{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".validate": "$room.matches(/^[a-z0-9-]{1,32}$/)",
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('rooms').child($room).child('members').child($uid).exists())",
            ".validate": "newData.hasChildren(['name', 'instrument', 't'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "instrument": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 12"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "pointers": {
              ".validate": "newData.hasChildren()",
              "$slot": {
                ".validate": "$slot.matches(/^[0-4]$/) && newData.hasChildren(['x', 'y', 'down'])",
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                },
                "down": {
                  ".validate": "newData.isBoolean()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'joined'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "joined": {
              ".validate": "newData.val() === now || newData.val() === data.val()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$room": {
        ".validate": "$room.matches(/^[a-z0-9-]{1,32}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === 'play' || newData.val() === 'watch'"
        }
      }
    }
  }
}
